# Go API configuration. The service reads the process environment only:
# export these before `go run ./cmd/api`, or let docker compose inject them.

HTTP_ADDR=:8080

# Required. One database, schemas seg + core.
DATABASE_URL=postgres://admin:my_admin_pass@localhost:5432/melia?sslmode=disable

# Required. host:port
REDIS_ADDR=localhost:6379

# Optional. Leave empty to omit the rabbitmq readiness probe.
RABBITMQ_URL=amqp://admin:admin_pass@localhost:5672/

# Directory holding the canonical NN-*.sql schema files.
# From api/ when running with `go run`: ../database/init
DB_INIT_DIR=../database/init

# Apply pending schema files at startup. Set to false when another tool owns the schema.
DB_AUTO_MIGRATE=true

# debug | info | warn | error
LOG_LEVEL=info
